{
  "name": "bookly-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --port 5173",
    "build": "vite build",
    "build:android": "vite build --mode android",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "seed:e2e": "bash tests/e2e/seed-e2e.sh",
    "android:sync": "npm run build:android && npx cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:apk:release": "npm run android:sync && cd android && ./gradlew assembleRelease",
    "android:aab": "npm run android:sync && cd android && ./gradlew bundleRelease",
    "android:install": "adb install -r android/app/build/outputs/apk/release/app-release.apk",
    "android:run": "adb shell am start -n com.bookly.app/.MainActivity",
    "android:logs": "adb logcat | grep -iE 'bookly|Capacitor|chromium'",
    "celular:conectar": "bash scripts/conectar.sh",
    "celular:instalar": "bash scripts/auto-instalar.sh --instalar",
    "celular:desarrollo": "bash scripts/desarrollo.sh",
    "mfa:codigo": "node scripts/mfa-codigo.mjs",
    "mfa:reset": "node scripts/mfa-codigo.mjs --reset",
    "mfa:enrolar": "node scripts/enrolar-mfa.mjs"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-auto": "^3.3.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.8.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "otpauth": "^9.5.2",
    "sass": "^1.80.0",
    "svelte": "^5.1.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/device": "^8.0.3",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/network": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@types/qrcode": "^1.5.5",
    "lucide-svelte": "^1.0.1",
    "qrcode": "^1.5.4"
  }
}
