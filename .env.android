# Variables de entorno para el build del APK de desarrollo.
#
# El APK no tiene proxy de Vite: el WebView de Capacitor sirve la app desde
# https://localhost, así que la API necesita una URL absoluta.
#
# - localhost  → el propio dispositivo, con `adb reverse tcp:18080 tcp:18080`
# - 10.0.2.2   → el host visto desde el emulador de Android
VITE_API_URL=http://localhost:18080/api/v1
